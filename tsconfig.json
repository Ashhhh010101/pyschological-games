{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "rootDir": "frontend/src",
    "outDir": "frontend/dist",
    "strict": true,
    "noEmitOnError": true,
    "removeComments": true
  },
  "include": ["frontend/src/**/*.ts"]
}

