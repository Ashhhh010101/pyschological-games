# Local process or host-side Compose port.
HOST=127.0.0.1
PORT=8000

# Compose database credential. Replace this outside local development.
POSTGRES_PASSWORD=change-me

# Direct local development database. The application selects its adapter from
# this URL at runtime.
DATABASE_URL=sqlite+aiosqlite:///./data/psychological_games.db

# Leave blank for the Compose PostgreSQL default, or provide another async URL.
# For the supported containerized SQLite layout, use compose.sqlite.yaml.
COMPOSE_DATABASE_URL=
REDIS_URL=

# Comma-separated browser origins and Host header allowlist.
ALLOWED_ORIGINS=
TRUSTED_HOSTS=*
TRUST_PROXY_HEADERS=false

# Retention, sessions, payloads, and request controls.
ROOM_IDLE_TTL_SECONDS=3600
SESSION_TTL_SECONDS=86400
LOCK_TIMEOUT_SECONDS=15
LOCK_WAIT_SECONDS=5
PAYLOAD_MAX_BYTES=65536
RATE_LIMIT_ENABLED=true

# Structured logs are on by default. Set OTEL_ENABLED=true and start the
# Compose observability profile to export OTLP data to the bundled collector.
LOG_LEVEL=INFO
LOG_JSON=true
OTEL_ENABLED=false
